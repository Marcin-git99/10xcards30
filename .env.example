SUPABASE_URL=###
SUPABASE_KEY=###

# Testy (npm test) czytaja .env.test, nie ten plik. Wygeneruj go z lokalnego
# stacka — `npx supabase status -o env` daje API_URL i ANON_KEY:
#
#   .env.test
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_KEY=<ANON_KEY z powyzszej komendy>
#
# Guard w test/setup.ts ubija caly przebieg, jesli SUPABASE_URL widziany przez
# `astro:env/server` nie wskazuje localhosta. Nie omijaj go — testy izolacji
# zakladaja konta i pisza wiersze.
