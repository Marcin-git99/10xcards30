---
import Layout from "@/layouts/Layout.astro";
import LibraryView from "@/components/library/LibraryView";
import { createClient } from "@/lib/supabase";
import type { Card } from "@/types";

// Auth guard żyje w `src/middleware.ts` (PROTECTED_ROUTES), tak jak dla
// /dashboard — do tej strony nie da się dojść bez sesji. Wcześniejszy guard na
// poziomie strony był obejściem podziału pasów z m2l5 (middleware należał do
// pasa A), a nie decyzją projektową; jako top-level `return` we frontmatterze
// wywracał też eslinta (astro-eslint-parser + no-misused-promises).
const supabase = createClient(Astro.request.headers, Astro.cookies);
let initialCards: Card[] = [];
let loadError = false;
if (supabase) {
  const { data, error } = await supabase.from("cards").select().order("created_at", { ascending: false });
  if (error) {
    console.error("Failed to load cards:", error);
    loadError = true;
  } else {
    // Bez `?? []`: odpowiedź PostgREST to union rozróżniany po `error`, więc w tej
    // gałęzi `data` jest już zawężone do wariantu sukcesu i nie może być nullem.
    initialCards = data as Card[];
  }
} else {
  loadError = true;
}

const generatedParam = Number(Astro.url.searchParams.get("generated"));
const generatedCount = Number.isInteger(generatedParam) && generatedParam > 0 ? generatedParam : 0;
---

<Layout title="Moje fiszki">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl space-y-6 py-8">
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
        <LibraryView initialCards={initialCards} loadError={loadError} generatedCount={generatedCount} client:load />
      </div>
    </div>
  </div>
</Layout>
